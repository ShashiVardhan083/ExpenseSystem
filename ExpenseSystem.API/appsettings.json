{
    "ConnectionStrings": {
        "DefaultConnection": "Server=.\\SQLEXPRESS;Database=ExpenseSystemDb;Trusted_Connection=True;TrustServerCertificate=True"
        //"DefaultConnection": "Server=sqlserver;Database=ExpenseSystemDb;User Id=sa;Password=YourStrong@Pass123;TrustServerCertificate=True"
    },

    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Information",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "logs/expense-api-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ]
    },
    "JwtSettings": {
        "SecretKey": "THIS_IS_A_SUPER_SECRET_KEY_123456789",
        "Issuer": "ExpenseSystemAPI",
        "Audience": "ExpenseSystemClient",
        "ExpiryHours": 24
    },

    "AllowedHosts": "*",
    "PaymentGateway": {
        "BaseUrl": "http://localhost:7291/",
        "TimeoutSeconds": 30
    }
}