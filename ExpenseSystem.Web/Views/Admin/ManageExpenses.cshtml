@model IEnumerable<ExpenseSystem.Application.DTOs.ExpenseResponseDto>

@{
    ViewData["Title"] = "All Expenses";
}

<h4>Server Time: @ViewBag.Time</h4>

<div class="page-header">
    <h1>📋 All Expense Claims</h1>
    @if (User.IsInRole("Employee"))
    {
        <a asp-controller="Expenses"
           asp-action="Create"
           class="btn btn-primary">
            + Submit New Expense
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📭</div>
        <h3>No expenses found</h3>
        <p>No expense claims have been submitted.</p>
    </div>
}
else
{
    <div class="expense-grid">
        @foreach (var expense in Model)
        {
            <div class="expense-card">
                <div class="expense-header">
                    <span class="badge badge-@expense.Status.ToLower()">@expense.Status</span>
                    <span class="expense-amount">@expense.Amount.ToString("C")</span>
                </div>

                <h3>@expense.EmployeeName</h3>
                <p class="expense-description">@expense.Description</p>

                <div class="expense-meta">
                    <span>📅 @expense.CreatedDate.ToString("MMM dd, yyyy")</span>
                    @if (expense.ProcessedDate.HasValue)
                    {
                        <span>✅ @expense.ProcessedDate.Value.ToString("MMM dd, yyyy")</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(expense.PaymentReference))
                {
                    <div class="payment-reference">💳 @expense.PaymentReference</div>
                }

                <div class="expense-actions">
                    <a href="/Expenses/Details/@expense.Id"
                       class="btn btn-secondary btn-sm">
                        View Details
                    </a>

                    @if (expense.Status == "Submitted")
                    {
                        <form asp-controller="Expenses"
                              asp-action="Approve"
                              asp-route-id="@expense.Id"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-success btn-sm">
                                ✓ Approve
                            </button>
                        </form>

                        <a href="/Expenses/Reject/@expense.Id"
                           class="btn btn-danger btn-sm">
                            ✗ Reject
                        </a>
                    }

                    @if (User.IsInRole("Employee")
                                && !User.IsInRole("Admin")
                                && expense.Status == "Approved")
                    {
                        <form asp-action="ProcessPayment"
                              asp-route-id="@expense.Id"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-primary btn-sm">
                                💰 Pay
                            </button>
                        </form>
                    }

                </div>
            </div>
        }
    </div>

    <div class="stats-summary">
        <div class="stat-box">
            <div class="stat-number">@Model.Count()</div>
            <div class="stat-label">Total</div>
        </div>

        <div class="stat-box">
            <div class="stat-number">@Model.Count(e => e.Status == "Submitted")</div>
            <div class="stat-label">Pending</div>
        </div>

        <div class="stat-box">
            <div class="stat-number">@Model.Count(e => e.Status == "Approved")</div>
            <div class="stat-label">Approved</div>
        </div>

        <div class="stat-box">
            <div class="stat-number">@Model.Count(e => e.Status == "Paid")</div>
            <div class="stat-label">Paid</div>
        </div>

        <div class="stat-box">
            <div class="stat-number">@Model.Sum(e => e.Amount).ToString("C")</div>
            <div class="stat-label">Total Amount</div>
        </div>
    </div>
}
